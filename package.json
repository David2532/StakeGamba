{
  "name": "twist-turbo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "lint": "node scripts/run-workspace-task.mjs lint",
    "format": "turbo run format",
    "dev": "turbo run dev",
    "build": "node scripts/run-workspace-task.mjs build",
    "preview": "turbo run preview",
    "real-build-storybook": "turbo run real-build-storybook",
    "storybook": "turbo run storybook",
    "stake:publish": "node scripts/stake-publish.mjs",
    "stake:publish:cross-platform": "node scripts/stake-publish.mjs",
    "stake:publish:windows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-stake-publish.ps1 -BuildFrontend -RefreshMath -ReuseBooks",
    "stake:release": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stake-release-pipeline.ps1",
    "stake:publish:full-math": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-stake-publish.ps1 -BuildFrontend -RefreshMath",
    "stake:publish:archive-legacy": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-stake-publish.ps1 -BuildFrontend -RefreshMath -ReuseBooks -ArchiveLegacy",
    "stake:publish:build-frontend": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-stake-publish.ps1 -BuildFrontend",
    "stake:publish:refresh-math": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-stake-publish.ps1 -RefreshMath",
    "stake:install-hook": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-stake-publish-hook.ps1",
    "stake:qa": "node apps/cluster/scripts/build-preview-html.mjs && cross-env STAKE_QA_REQUIRE_E2E=1 node scripts/stake-qa.mjs all && npm run stake:qa:docs:write",
    "stake:qa:docs": "node scripts/verify-stake-documentation.mjs --check",
    "stake:qa:docs:write": "node scripts/verify-stake-documentation.mjs --write --check",
    "stake:qa:currency": "node apps/cluster/scripts/build-preview-html.mjs && node scripts/stake-qa.mjs currency",
    "stake:qa:social": "node apps/cluster/scripts/build-preview-html.mjs && cross-env STAKE_QA_REQUIRE_E2E=1 node scripts/stake-qa.mjs social",
    "stake:qa:replay": "node apps/cluster/scripts/build-preview-html.mjs && cross-env STAKE_QA_REQUIRE_E2E=1 node scripts/stake-qa.mjs replay",
    "stake:qa:wallet": "node scripts/stake-rgs-wallet-feature-test.mjs",
    "stake:qa:math": "node scripts/stake-qa.mjs math-integrity",
    "stake:qa:i18n": "node scripts/stake-qa.mjs i18n",
    "stake:qa:mobile": "node apps/cluster/scripts/build-preview-html.mjs && node scripts/stake-qa.mjs mobile",
    "stake:qa:major-actions": "node apps/cluster/scripts/build-preview-html.mjs && node scripts/stake-qa.mjs major-actions",
    "stake:qa:interrupted-round": "node apps/cluster/scripts/build-preview-html.mjs && node scripts/stake-qa.mjs interrupted-round",
    "stake:qa:insufficient-funds": "node apps/cluster/scripts/build-preview-html.mjs && node scripts/stake-qa.mjs insufficient-funds",
    "stake:qa:rules": "node apps/cluster/scripts/build-preview-html.mjs && node scripts/stake-qa.mjs rules",
    "stake:qa:paytable": "node apps/cluster/scripts/build-preview-html.mjs && node scripts/stake-qa.mjs paytable",
    "stake:qa:regression": "node scripts/stake-qa.mjs regression",
    "stake:qa:e2e": "node apps/cluster/scripts/build-preview-html.mjs && cross-env STAKE_QA_REQUIRE_E2E=1 node scripts/stake-qa.mjs e2e",
    "publish-packages": "turbo run build lint test && changeset version && changeset publish",
    "e2e": "turbo run e2e",
    "e2e-smoke": "turbo run e2e-smoke",
    "e2e-mobile": "turbo run e2e-mobile"
  },
  "dependencies": {
    "eslint": "9.21.0",
    "eslint-config-custom": "workspace:*",
    "prettier": "3.5.2",
    "prettier-plugin-svelte": "3.3.3",
    "turbo": "2.4.4"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.5.0",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "playwright": "^1.61.1"
  }
}
