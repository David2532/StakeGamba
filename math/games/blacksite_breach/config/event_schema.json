{
  "schema_version": 3,
  "contract": "blacksite-book-events-v3",
  "closed_records": true,
  "units": {
    "payout_raw": "centi-x_uint64; raw 100 = 1.00x",
    "cost_multiplier": "integer multiple of base Play Amount",
    "board": "five column-major arrays, each containing three canonical symbol ids"
  },
  "enums": {
    "mode": ["base", "deep_access", "blackout"],
    "phase": ["base", "feature"],
    "regular_symbol": [
      "operative",
      "encrypted_drive",
      "tactical_radio",
      "classified_folder",
      "night_vision_goggles",
      "supply_crate",
      "a",
      "k",
      "q",
      "j",
      "ten"
    ],
    "paying_symbol": [
      "operative",
      "encrypted_drive",
      "tactical_radio",
      "classified_folder",
      "night_vision_goggles",
      "supply_crate",
      "a",
      "k",
      "q",
      "j",
      "ten",
      "ghost_wild"
    ],
    "symbol": [
      "operative",
      "encrypted_drive",
      "tactical_radio",
      "classified_folder",
      "night_vision_goggles",
      "supply_crate",
      "ghost_wild",
      "breach",
      "a",
      "k",
      "q",
      "j",
      "ten"
    ]
  },
  "records": {
    "position": [
      { "name": "column", "type": "uint_0_4" },
      { "name": "row", "type": "uint_0_2" }
    ],
    "line_win_item": [
      { "name": "line_id", "type": "uint_0_9" },
      { "name": "symbol", "type": "enum:paying_symbol" },
      { "name": "match_count", "type": "uint_3_5" },
      { "name": "positions", "type": "array:position:length_match_count" },
      { "name": "wild_positions", "type": "array:position:subset_positions" },
      { "name": "base_payout_raw", "type": "uint64" },
      { "name": "calculated_award_raw", "type": "uint64" },
      { "name": "applied_award_raw", "type": "uint64" }
    ]
  },
  "events": {
    "round_start": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:round_start" },
      { "name": "schema_version", "type": "literal:3" },
      { "name": "event_contract", "type": "literal:blacksite-book-events-v3" },
      { "name": "mode", "type": "enum:mode" },
      { "name": "cost_multiplier", "type": "canonical_mode_cost" },
      { "name": "payout_unit", "type": "literal:centi-x_uint64" },
      { "name": "max_win_raw", "type": "literal:1000000" },
      { "name": "board_columns", "type": "literal:5" },
      { "name": "board_rows", "type": "literal:3" },
      { "name": "payline_count", "type": "literal:10" },
      { "name": "initial_phase", "type": "enum:phase" },
      { "name": "guaranteed_breach_positions", "type": "array:position" }
    ],
    "spin_set": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:spin_set" },
      { "name": "phase", "type": "enum:phase" },
      { "name": "spin_index", "type": "uint" },
      { "name": "board", "type": "board_5x3" }
    ],
    "expansion_applied": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:expansion_applied" },
      { "name": "free_spin_index", "type": "uint_1_8" },
      { "name": "target_symbol", "type": "enum:regular_symbol" },
      { "name": "expanded_reels", "type": "nonempty_sorted_unique_array:uint_0_4" },
      { "name": "evaluated_board", "type": "board_5x3" }
    ],
    "line_win": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:line_win" },
      { "name": "phase", "type": "enum:phase" },
      { "name": "spin_index", "type": "uint" },
      { "name": "wins", "type": "nonempty_array:line_win_item:ascending_line_id" },
      { "name": "step_calculated_raw", "type": "positive_uint64" },
      { "name": "step_payout_raw", "type": "positive_uint64" },
      { "name": "cumulative_before_raw", "type": "uint64" },
      { "name": "cumulative_after_raw", "type": "uint64" },
      { "name": "cap_applied", "type": "boolean" }
    ],
    "feature_trigger": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:feature_trigger" },
      { "name": "positions", "type": "array:position:distinct_reels" },
      { "name": "distinct_reels", "type": "uint_3_5" },
      { "name": "awarded_free_spins", "type": "literal:8" }
    ],
    "feature_start": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:feature_start" },
      { "name": "direct", "type": "boolean" },
      { "name": "target_symbol", "type": "enum:regular_symbol" },
      { "name": "total_free_spins", "type": "literal:8" }
    ],
    "free_spin_start": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:free_spin_start" },
      { "name": "free_spin_index", "type": "uint_1_8" },
      { "name": "total_free_spins", "type": "literal:8" },
      { "name": "remaining_after_current", "type": "uint_0_7" }
    ],
    "feature_end": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:feature_end" },
      { "name": "spins_played", "type": "literal:8" },
      { "name": "total_free_spins", "type": "literal:8" },
      { "name": "cumulative_payout_raw", "type": "uint64" },
      { "name": "capped", "type": "literal:false" }
    ],
    "cap_reached": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:cap_reached" },
      { "name": "cap_raw", "type": "literal:1000000" },
      { "name": "gross_award_raw", "type": "positive_uint64" },
      { "name": "accepted_award_raw", "type": "positive_uint64" },
      { "name": "discarded_award_raw", "type": "uint64" },
      { "name": "cumulative_payout_raw", "type": "literal:1000000" }
    ],
    "round_end": [
      { "name": "index", "type": "uint" },
      { "name": "type", "type": "literal:round_end" },
      { "name": "mode", "type": "enum:mode" },
      { "name": "final_phase", "type": "enum:phase" },
      { "name": "payout_multiplier_raw", "type": "uint64" },
      { "name": "capped", "type": "boolean" }
    ]
  },
  "ordering_grammar": {
    "base_no_feature": "round_start -> spin_set -> [line_win] -> round_end",
    "base_feature": "round_start -> spin_set -> [line_win] -> feature_trigger -> feature_start -> eight_free_spins -> [feature_end] -> round_end",
    "direct_feature": "round_start -> feature_start -> eight_free_spins -> [feature_end] -> round_end",
    "eight_free_spins": "eight repetitions of free_spin_start -> spin_set -> [expansion_applied] -> [line_win]",
    "cap_termination": "line_win -> cap_reached -> round_end",
    "rules": [
      "event indices are contiguous and zero-based",
      "a spin_set is evaluated exactly once; expansion_applied is required iff the free-spin board contains the selected target",
      "line_win contains every and only canonical paying line from the evaluated board in ascending line id order",
      "feature_trigger is forbidden during free spins because retrigger is disabled",
      "cap_reached terminates immediately and suppresses later feature events"
    ]
  }
}
