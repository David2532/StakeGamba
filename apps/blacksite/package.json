{
	"name": "blacksite",
	"version": "0.1.0-m2",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 3002",
		"build": "node scripts/build-production.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"fixtures:build": "node scripts/build-fixture-catalog.mjs",
		"preview": "vite preview --host 127.0.0.1 --port 4302",
		"lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"src\"",
		"test": "node --test tests/*.test.mjs",
		"qa:e2e": "pnpm run build && node ../../scripts/blacksite-qa-e2e.mjs"
	},
	"dependencies": {
		"@sveltejs/kit": "2.17.3",
		"svelte": "5.20.5",
		"utils-shared": "workspace:*",
		"vite": "6.4.3"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"axe-core": "4.13.0",
		"config-svelte": "workspace:*",
		"config-ts": "workspace:*",
		"cross-env": "^10.1.0",
		"eslint": "9.21.0",
		"eslint-config-custom": "workspace:*",
		"svelte-check": "4.7.6"
	}
}
